# Required. The service refuses to start without it. Generate with:
#   openssl rand -hex 32
API_KEY=

# Origins allowed to call the public read endpoints, comma-separated.
# Empty means no browser origin is allowed.
CORS_ORIGINS=https://danilocloud.me

DATABASE_URL=file:/data/coffee.db
LOG_LEVEL=info
PORT=8000
MAX_CAFFEINE_MG=1000
